# Secrets and credentials - never let the AI assistant read these
.env
.env.*
config/master.key
config/credentials/*.key

# Runtime / generated artifacts (noise, not source of truth)
tmp/
log/
storage/
node_modules/

# Additional sensitive / non-useful files investigated with the AI assistant:
# - Encrypted Rails credentials (paired with the master key above)
config/credentials.yml.enc
config/credentials/*.yml.enc
# - Any stray secret/key material that could leak production access
*.pem
*.key
*.p12
*.pfx
# - Deploy secrets (Kamal stores registry/SSH secrets here)
.kamal/secrets
# - Local databases / dumps that may contain real user data
*.sqlite3
*.sqlite3-*
db/*.sqlite3
*.sql
*.dump
# - Compiled assets and dependency caches (large, regenerated, not source)
/public/assets/
.bundle/
vendor/bundle/
# - OS / editor cruft
.DS_Store
